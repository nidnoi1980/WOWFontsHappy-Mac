+// 启动服务器。源码模式保持原行为；Electron 打包模式可关闭外部浏览器。
+function startServer(options = {}) {
+    const port = options.port ?? DEFAULT_PORT;
+    const host = options.host || '127.0.0.1';
+    const openBrowserOnStart = options.openBrowserOnStart !== false;
+    const installSignalHandlers = options.installSignalHandlers !== false;
+
+    return new Promise((resolve, reject) => {
+        let settled = false;
+        const server = app.listen(port, host, () => {
+            const address = server.address();
+            const actualPort = address && typeof address === 'object' ? address.port : port;
+            const url = `http://${host}:${actualPort}`;
+
+            console.log('\n========================================');
+            console.log('  魔兽字体好开心已启动！');
+            console.log('========================================');
+            console.log(`  服务地址: ${url}`);
+            console.log(`  运行平台: ${PLATFORM}`);
+            console.log(`  系统字体目录: ${IS_MAC ? MAC_FONT_DIRS.join(' | ') : SYSTEM_FONT_DIR}`);
+            console.log('========================================\n');
+
+            if (openBrowserOnStart) {
+                console.log('  正在自动打开浏览器...\n');
+                setTimeout(() => openBrowser(url), 1000);
+            }
+
+            if (installSignalHandlers) {
+                const shutdown = () => {
+                    console.log('\n正在关闭服务...');
+                    server.close(() => {
+                        console.log('服务已关闭');
+                        process.exit(0);
+                    });
+                };
+                process.once('SIGINT', shutdown);
+                process.once('SIGTERM', shutdown);
+            }
+
+            settled = true;
+            resolve({ server, url, port: actualPort });
+        });
 
