+        let platformInfo = { platform: 'win32', separator: '\\', isWindows: true, isMac: false };
+
+        function joinPlatformPath() {
+            var parts = Array.prototype.slice.call(arguments);
+            var sep = platformInfo.separator || '\\';
+            if (parts.length === 0) return '';
+            var first = String(parts.shift() || '').replace(/[\\\/]+$/, '');
+            var rest = parts.map(function(part) {
+                return String(part || '').replace(/^[\\\/]+|[\\\/]+$/g, '');
+            }).filter(Boolean);
+            return [first].concat(rest).join(sep);
+        }
+
